workflows:
  ios-pwa:
    name: iOS PWA Build
    max_build_duration: 60
    instance_type: mac_mini_m2
    environment:
      ios_signing:
        distribution_type: app_store
        bundle_identifier: com.ouaid.tolleranze
      xcode: latest
      node: 20
      cocoapods: default
    scripts:
      - name: Build Capacitor App
        script: |
          npm install @capacitor/core@6 @capacitor/cli@6 @capacitor/ios@6 --save --force
          mkdir -p dist
          cp -R *.html *.png manifest.json dist/ 2>/dev/null || true
          echo '{"appId":"com.ouaid.tolleranze","appName":"ISO Tolleranze","webDir":"dist"}' > capacitor.config.json
          rm -rf ios
          npx cap add ios
          npx cap sync ios
          cd ios/App && pod install --repo-update && cd ../..
      - name: Build IPA
        script: |
          xcode-project use-profiles
          xcode-project build-ipa --workspace ios/App/App.xcworkspace --scheme App
    artifacts:
      - build/ios/ipa/*.ipa
